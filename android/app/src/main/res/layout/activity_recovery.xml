<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center"
    android:padding="32dp" android:background="#151618">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="King’s World" android:textColor="#E4B75A"
        android:textSize="18sp" android:fontFamily="serif" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="28dp" android:gravity="center"
        android:text="Vamos retomar seu reino" android:textColor="#F4E7C9"
        android:textSize="28sp" android:fontFamily="serif" />
    <TextView android:id="@+id/recovery_message" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:gravity="center"
        android:text="O jogo precisou liberar memória." android:textColor="#C4BDA9"
        android:textSize="16sp" />
    <Button android:id="@+id/recovery_retry" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="52dp"
        android:layout_marginTop="32dp" android:text="Voltar ao reino"
        android:textAllCaps="false" android:textColor="#211806" android:textSize="17sp"
        android:background="@drawable/recovery_action" />
</LinearLayout>
